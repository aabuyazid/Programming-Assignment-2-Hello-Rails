<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Rating</th>
      <th>Release Date</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date.strftime('%d-%b-%Y') %></td>
      </tr>
    <% end %>
  </tbody>


  <tfoot>
    <tr>
      <td colspan="3"><%= pluralize(@movies.size, 'Movie') %> Found</td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
