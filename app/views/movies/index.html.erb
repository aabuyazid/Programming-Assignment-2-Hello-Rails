<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table id="movies-table">
  <thead>
    <tr>
      <th data-sortable="title">Title</th>
      <th data-sortable="rating">Rating</th>
      <th data-sortable="release_date">Release Date</th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date.strftime('%d-%b-%Y') %></td>
      </tr>
    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="3"><%= pluralize(@movies.size, 'Movie') %> Found</td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path, class: "new-movie-link" %>
